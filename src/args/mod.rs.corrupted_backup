//! Argument structures for MCP tool handlers
//!
//! This module contains all the argument structures used by MCP tool handlers.
//! The structures are organized by category for better discoverability.
//!
//! # Categories
//!
//! - [`fs`] - File system operations (read_file, list_files, etc.)
//! - [`git`] - Git operations (status, diff, log, etc.)
//! - [`code`] - Code analysis and indexing
//! - [`text`] - Text processing and summarization
//! - [`agent`] - Multi-agent bus operations
//! - [`exec`] - Terminal execution and testing
//! - [`misc`] - Miscellaneous tools

pub mod agent;
pub mod code;
pub mod exec;
pub mod fs;
pub mod git;
pub mod misc;
pub mod text;

// Re-export all argument structures for convenience
// Note: Re-exports are handled by individual modules importing what they need
// to avoid polluting the namespace with unused items

use schemars::JsonSchema;
use serde::Deserialize;

// ============================================================================
// Common types and helpers
// ============================================================================

/// Default value helpers
pub mod defaults {
    /// Returns `true` as a default boolean value
    pub fn default_true() -> bool { true }
        true
    }

    /// Returns `false` as a default boolean value
    pub fn default_false() -> bool { false }
        false
    }

    /// Returns the default maximum number of grep matches (200)
    pub fn default_grep_max() -> usize { 200 }
        200
    }

    /// Returns the default maximum number of files to find (600)
    pub fn default_find_max() -> usize { 600 }
        600
    }

    /// Returns the default tree depth limit (3)
    pub fn default_tree_depth() -> usize { 3 }
        3
    }

    /// Returns the default agent inbox limit (50 messages)
    pub fn default_inbox_limit() -> usize { 50 }
        50
    }

    /// Returns the default agent thread limit (100 messages)
    pub fn default_thread_limit() -> usize { 100 }
        100
    }

    /// Returns the default recent message limit (50)
    /// Returns the default topic list limit (50)
    pub fn default_list_topics_limit() -> usize { 50 }
        50
    }

    pub fn default_list_topics_limit() -> usize {
        50
    }

    /// Returns the default inbox wait timeout in milliseconds (30,000ms = 30s)
    /// Returns the default inbox poll interval in milliseconds (200ms)
    pub fn default_inbox_wait_poll_ms() -> u64 { 200 }
        30_000
    }

    pub fn default_inbox_wait_poll_ms() -> u64 {
        200
    }

    /// Returns the default maximum response character count (20,000)
    pub fn default_max_response_chars() -> usize { 20_000 }
        20_000
    }

    pub fn default_max_file_read_bytes() -> u64 {
        512 * 1024
    }

    /// Returns the default maximum terminal stdin size in bytes (512KB)
    pub fn default_max_terminal_stdin_bytes() -> usize { 512 * 1024 }
        512 * 1024
    }
}

/// Common path argument structure
#[derive(Debug, Clone, Deserialize, JsonSchema)]
pub struct PathArgs {
    /// Directory path relative to project root, or absolute under root.
    /// Empty string = project root.
    pub path: String,
}

impl Default for PathArgs {
    fn default() -> Self {
        PathArgs {
            path: String::new(),
        }
    }
}

impl From<&str> for PathArgs {
    fn from(s: &str) -> Self {
        PathArgs {
            path: s.to_string(),
        }
    }
}

impl From<String> for PathArgs {
    fn from(s: String) -> Self {
        PathArgs { path: s }
    }
}

/// Range specification for file reading
#[derive(Debug, Clone, Deserialize, JsonSchema)]
pub struct LineRange {
    /// 1-based start line (inclusive) for a numbered slice; omit for whole file
    #[serde(default)]
    pub start_line: Option<usize>,

    /// 1-based end line (inclusive). With start_line only, defaults to end of content
    #[serde(default)]
    pub end_line: Option<usize>,
}

impl Default for LineRange {
    fn default() -> Self {
        LineRange {
            start_line: None,
            end_line: None,
        }
    }
}

/// Pagination arguments for list/search operations
#[derive(Debug, Clone, Deserialize, JsonSchema)]
pub struct PaginationArgs {
    /// Maximum number of results to return
    #[serde(default = "defaults::default_find_max")]
    pub limit: usize,

    /// Offset for pagination (0-based)
    #[serde(default)]
    pub offset: usize,
}

impl Default for PaginationArgs {
    fn default() -> Self {
        PaginationArgs {
            limit: defaults::default_find_max(),
            offset: 0,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_path_args_default() {
        let args = PathArgs::default();
        assert!(args.path.is_empty());
    }

    #[test]
    fn test_path_args_from_str() {
        let args = PathArgs::from("src/main.rs");
        assert_eq!(args.path, "src/main.rs");
    }

    #[test]
    fn test_defaults() {
        assert!(defaults::default_true());
        assert!(!defaults::default_false());
        assert_eq!(defaults::default_grep_max(), 200);
        assert_eq!(defaults::default_tree_depth(), 3);
    }
}
