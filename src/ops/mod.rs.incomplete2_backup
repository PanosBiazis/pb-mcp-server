pub fn git_blame_work(
    repo: PathBuf,
    file_rel: String,
    start_line: usize,
    end_line: usize,
    rev: Option<String>,
) -> String {
    let start = start_line.max(1);
    let end = end_line.max(start).min(start + 400);
    let mut cmd = Command::new("git");
    cmd.current_dir(&repo);
    cmd.args(["blame", "-b", "--no-color", "-L"])
        .arg(format!("{start},{end}"))
        .arg("--");
    cmd.arg(&file_rel);
    if let Some(ref r) = rev {
        match validate_git_refspec(r) {
            Ok(valid) => {
                cmd.arg(valid);
            }
            Err(e) => return format!("Error: {e}"),
        }
    }
    match cmd.output() {
        Ok(out) => {
            let mut body = format!(
                "REPO: {}\nFILE: {file_rel}\nLINES: {start}-{end}\nREV: {}\nEXIT: {}\n",
                repo.display(),
                rev.as_ref().map(|s| s.as_str()).unwrap_or("HEAD"),
                out.status.code().map(|c| c.to_string()).unwrap_or_default()
            );
            let stdout = String::from_utf8_lossy(&out.stdout);
            let (stdout, clipped) = truncate_chars(stdout.trim_end(), MAX_GIT_BLAME_CHARS);
            body.push_str(&stdout);
            if !out.stderr.is_empty() {
                body.push_str("\nSTDERR:\n");
                body.push_str(&String::from_utf8_lossy(&out.stderr));
            }
            if clipped {
                body.push_str(&format!(
                    "\n\n[blame output truncated to {MAX_GIT_BLAME_CHARS} characters]"
                ));
            }
            body
        }
        Err(e) => format!("Error running git blame: {e}"),
    }
}

pub fn git_rev_parse_work(repo: PathBuf, refs: Vec<String>) -> String {
    let mut body = format!("REPO: {}\n", repo.display());
    let valid_refs: Vec<String> = refs
        .into_iter()
        .filter(|r| validate_git_refspec(r).is_ok())
        .take(16)
        .collect();
    body.push_str(&format!("ARGS: {:?}\n\n", valid_refs));
    for r in valid_refs {
        let output = Command::new("git")
            .current_dir(&repo)
            .args(["rev-parse", "--verify", "--end-of-options"])
            .arg(&r)
            .output();
        match output {
            Ok(out) => {
                let sha = String::from_utf8_lossy(&out.stdout).trim().to_string();
                let status = out.status.code().unwrap_or(-1);
                body.push_str(&format!("{r} -> {sha} (exit {status})\n"));
            }
            Err(e) => body.push_str(&format!("{r} -> error: {e}\n")),
        }
    }
    body
}

pub fn read_file_tail_work(path: PathBuf, last_lines: usize) -> String {
    let meta = match fs::metadata(&path) {
        Ok(m) => m,
        Err(e) => return format!("Error: {e}"),
    };
    if !meta.is_file() {
        return "Error: path is not a file".to_string();
    }
    let len = meta.len();
    let n = last_lines.clamp(1, MAX_TAIL_LINES);
    let window_bytes = 128 * 1024;
    let offset = len.saturating_sub(window_bytes);
    let mut file = match fs::File::open(&path) {
        Ok(f) => f,
        Err(e) => return format!("Error opening {}: {e}", path.display()),
    };
    if let Err(e) = file.seek(SeekFrom::Start(offset)) {
        return format!("Error seeking: {e}");
    }
    let mut buf = Vec::new();
    if let Err(e) = file.take(window_bytes as u64).read_to_end(&mut buf) {
        return format!("Error reading: {e}");
    }
    let text = String::from_utf8_lossy(&buf);
    let lines: Vec<&str> = text.lines().collect();
    let total_in_window = lines.len();
    let start = total_in_window.saturating_sub(n);
    let mut body = format!(
        "FILE: {} (last {} lines of {} bytes; showing last {} lines from {} byte window)\n\n",
        path.display(),
        n,
        len,
        total_in_window - start,
        window_bytes
    );
    if offset > 0 {
        body.push_str(&format!(
            "[Note: file is large; only last ~{window_bytes} bytes were scanned]\n\n"
        ));
    }
    for (i, line) in lines[start..].iter().enumerate() {
        body.push_str(&format!("{:6}| {}\n", start + i + 1, line));
    }
    let (body, clipped) = truncate_chars(&body, MAX_RESPONSE_CHARS);
    if clipped {
        format!("{body}\n\n[truncated to {MAX_RESPONSE_CHARS} characters]")
    } else {
        body
    }
}

pub fn file_stats_work(path: PathBuf) -> String {
    let meta = match fs::metadata(&path) {
        Ok(m) => m,
        Err(e) => return format!("Error: {e}"),
    };
    if !meta.is_file() {
        return "Error: path is not a file".to_string();
    }
    let len = meta.len();
    let mut file = match fs::File::open(&path) {
        Ok(f) => f,
        Err(e) => return format!("Error opening {}: {e}", path.display()),
    };
    let scan_limit = MAX_STATS_SCAN_BYTES.min(len);
    let mut buf = Vec::new();
    if let Err(e) = file.take(scan_limit).read_to_end(&mut buf) {
        return format!("Error reading: {e}");
    }
    let has_nul = buf.iter().any(|&b| b == 0);
    let text = String::from_utf8_lossy(&buf);
    let lines = text.lines().count();
    let sample: String = text.chars().take(200).collect();
    format!(
        "FILE: {}\nSIZE: {} bytes\nSCANNED: {} bytes\nLINES_EST: {}\nHAS_NUL_BYTES: {}\nSAMPLE:\n{}\n",
        path.display(),
        len,
        scan_limit,
        lines,
        has_nul,
        sample
    )
}

pub fn find_files_by_name_work(
    search_root: PathBuf,
    needle: String,
    case_insensitive: bool,
    max_files: usize,
) -> String {
    let max_files = max_files.min(MAX_NAME_SEARCH_FILES);
    let mut walk = WalkBuilder::new(&search_root);
    walk.git_ignore(true).ignore(true).hidden(false);
    let mut paths = Vec::new();
    let needle_cmp = if case_insensitive {
        needle.to_lowercase()
    } else {
        needle.clone()
    };
    for entry in walk.build().flatten() {
        if paths.len() >= max_files {
            break;
        }
        let path = entry.path();
        if !path.is_file() {
            continue;
        }
        let rel = match path.strip_prefix(&search_root) {
            Ok(p) => p,
            Err(_) => continue,
        };
        let rel_str = normalize_rel_path(rel);
        let matches = if case_insensitive {
            rel_str.to_lowercase().contains(&needle_cmp)
        } else {
            rel_str.contains(&needle)
        };
        if matches {
            paths.push(rel_str);
        }
    }
    paths.sort();
    let n = paths.len();
    let listed = paths.join("\n");
    let mut out = format!(
        "SEARCH_ROOT: {}\nSUBSTRING: {needle}\nCASE_INSENSITIVE: {case_insensitive}\nFILES: {n}\n\n{listed}",
        search_root.display()
    );
    if n >= max_files {
        out.push_str(&format!(
            "\n\n[stopped at {max_files} paths; narrow `substring` or `path`]"
        ));
    }
    out
}

pub fn read_json_file_work(path: PathBuf) -> String {
    let meta = match fs::metadata(&path) {
        Ok(m) => m,
        Err(e) => return format!("Error: {e}"),
    };
    if !meta.is_file() {
        return "Error: path is not a file".to_string();
    }
    let len = meta.len();
    if len > MAX_JSON_VALIDATE_BYTES {
        return format!(
            "Error: JSON file too large ({} > {MAX_JSON_VALIDATE_BYTES} bytes)",
            len
        );
    }
    let text = match fs::read_to_string(&path) {
        Ok(t) => t,
        Err(e) => return format!("Error reading {}: {e}", path.display()),
    };
    match serde_json::from_str::<serde_json::Value>(&text) {
        Ok(val) => {
            let mut body = format!("FILE: {}\nSIZE: {} bytes\n\n", path.display(), len);
            match val {
                serde_json::Value::Object(map) => {
                    body.push_str(&format!("JSON_OBJECT with {} keys\n", map.len()));
                    let keys: Vec<_> = map.keys().take(20).collect();
                    body.push_str("SAMPLE_KEYS:\n");
                    for k in keys {
                        body.push_str(&format!("  - {k}\n"));
                    }
                    if map.len() > 20 {
                        body.push_str(&format!("  ... and {} more\n", map.len() - 20));
                    }
                }
                serde_json::Value::Array(arr) => {
                    body.push_str(&format!("JSON_ARRAY with {} elements\n", arr.len()));
                }
                other => {
                    body.push_str(&format!("JSON_TYPE: {:?}\n", other));
                }
            }
            body
        }
        Err(e) => format!("Error: invalid JSON: {e}"),
    }
}

pub fn batch_file_info_work(paths: Vec<PathBuf>) -> String {
    let mut results = Vec::new();
    for path in paths.into_iter().take(MAX_BATCH_FILE_INFO) {
        let meta = match fs::metadata(&path) {
            Ok(m) => m,
            Err(e) => {
                results.push(format!("PATH: {}\nError: {e}\n---\n", path.display()));
                continue;
            }
        };
        let kind = if meta.is_dir() {
            "directory"
        } else if meta.is_file() {
            "file"
        } else {
            "other"
        };
        let size = meta.len();
        let mtime = meta
            .modified()
            .ok()
            .and_then(|t| {
                t.duration_since(UNIX_EPOCH)
                    .ok()
                    .map(|d| d.as_secs().to_string())
            })
            .unwrap_or_else(|| "unknown".to_string());
        results.push(format!(
            "PATH: {}\nKIND: {}\nSIZE: {}\nMTIME_EPOCH: {}\n---\n",
            path.display(),
            kind,
            size,
            mtime
        ));
    }
    results.join("\n")
}

pub fn workspace_context_work(root: PathBuf) -> String {
    let base = root.canonicalize().unwrap_or(root);
    let mut out = String::new();
    out.push_str("WORKSPACE_CONTEXT\n\n");
    out.push_str(&format!("project_root: {}\n", base.display()));
    let git_check = Command::new("git")
        .current_dir(&base)
        .args(["rev-parse", "--is-inside-work-tree"])
        .output();
    match git_check {
        Ok(o) if o.status.success() && String::from_utf8_lossy(&o.stdout).trim() == "true" => {
            out.push_str("git_repo: yes\n");
            if let Ok(b) = Command::new("git")
                .current_dir(&base)
                .args(["branch", "--show-current"])
                .output()
            {
                let name = String::from_utf8_lossy(&b.stdout).trim().to_string();
                if !name.is_empty() {
                    out.push_str(&format!("git_branch: {name}\n"));
                }
            }
        }
        _ => out.push_str("git_repo: no (or git unavailable)\n"),
    }
    out.push_str("\nTop-level entries (max 40, sorted):\n");
    match fs::read_dir(&base) {
        Ok(rd) => {
            let mut names: Vec<String> = rd
                .flatten()
                .map(|e| e.file_name().to_string_lossy().into_owned())
                .collect();
            names.sort();
            let total = names.len();
            for n in names.iter().take(40) {
                out.push_str(&format!("  {n}\n"));
            }
            if total > 40 {
                out.push_str(&format!("  ... and {} more\n", total - 40));
            }
        }
        Err(e) => out.push_str(&format!("Error listing: {e}\n")),
    }
    out.push_str("\nTOOL_LIMITS:\n");
    out.push_str(&format!("  MAX_FILE_READ_BYTES: {MAX_FILE_READ_BYTES}\n"));
    out.push_str(&format!("  MAX_RESPONSE_CHARS: {MAX_RESPONSE_CHARS}\n"));
    out.push_str(&format!("  MAX_GREP_MATCHES: {MAX_GREP_MATCHES}\n"));
    out.push_str(&format!("  MAX_FIND_FILES: {MAX_FIND_FILES}\n"));
    out.push_str(&format!("  MAX_DIFF_CHARS: {MAX_DIFF_CHARS}\n"));
    out.push_str(&format!("  MAX_GIT_LOG_CHARS: {MAX_GIT_LOG_CHARS}\n"));
    let bus_path = base.join(".mint-mcp").join("agent-bus.jsonl");
    if bus_path.exists() {
        out.push_str("\nMULTI_AGENT_BUS: present\n");
    } else {
        out.push_str("\nMULTI_AGENT_BUS: absent\n");
    }
    out
}

