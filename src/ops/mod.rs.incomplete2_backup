// Tests
#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_truncate_chars() {
        let s = "Hello, world!";
        let (truncated, was_truncated) = truncate_chars(s, 5);
        assert_eq!(truncated, "Hello");
        assert!(was_truncated);

        let (not_truncated, was_not) = truncate_chars(s, 100);
        assert_eq!(not_truncated, s);
        assert!(!was_not);
    }

    #[test]
    fn test_validate_git_refspec() {
        assert!(validate_git_refspec("HEAD").is_ok());
        assert!(validate_git_refspec("main").is_ok());
        assert!(validate_git_refspec("v1.0.0").is_ok());
        assert!(validate_git_refspec("abc123").is_ok());
        assert!(validate_git_refspec("").is_err());
        assert!(validate_git_refspec("foo bar").is_err());
        assert!(validate_git_refspec("foo;rm -rf /").is_err());
    }

    #[test]
    fn test_path_rel_to_repo() {
        let repo = PathBuf::from("/home/user/project");
        let file = PathBuf::from("/home/user/project/src/main.rs");
        assert_eq!(
            path_rel_to_repo(&repo, &file),
            Some("src/main.rs".to_string())
        );

        let outside = PathBuf::from("/home/other/file.rs");
        assert_eq!(path_rel_to_repo(&repo, &outside), None);
    }
}
