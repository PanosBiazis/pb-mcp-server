    let mut scan_truncated = false;
    for entry in walk.build().flatten() {
        if files_seen >= scan_budget {
            scan_truncated = true;
            break;
        }
        let path = entry.path();
        if !path.is_file() {
            continue;
        }
        let meta = match fs::metadata(path) {
            Ok(m) => m,
